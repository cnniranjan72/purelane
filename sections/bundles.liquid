{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-bundles.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign tier_blocks = section.blocks | where: 'type', 'tier' -%}

<section
  id="bundles"
  class="bundles color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    %}

    {%- if tier_blocks.size > 0 -%}
      <div class="tiers tiers--{{ tier_blocks.size }}">
        {%- for block in tier_blocks -%}
          {%- assign features = block.settings.features | newline_to_br | split: '<br />' -%}
          <article
            class="tier pl-surface pl-tilt{% if block.settings.highlight %} tier--highlight{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.tag != blank -%}
              <span class="tier__tag">{{ block.settings.tag | escape }}</span>
            {%- endif -%}

            {%- if block.settings.quantity > 0 -%}
              <div class="tier__qty">
                {{ block.settings.quantity }}
                <small>Products</small>
              </div>
            {%- endif -%}

            {% render 'price-tag', price: block.settings.price, compare_at_price: block.settings.compare_at_price %}

            {%- if features.size > 0 -%}
              <ul class="tier__features">
                {%- for feature in features -%}
                  {%- if feature != blank -%}
                    <li>
                      {% render 'icon', name: 'check', size: 16 %}
                      {{ feature | strip | escape }}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a
                {% if block.settings.cta_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.cta_link }}"
                {% endif %}
                class="button{% if block.settings.highlight %} button--primary{% else %} button--secondary{% endif %} tier__cta"
              >
                {{- block.settings.cta_label | escape -}}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="bundles__empty">Add a tier block to build the bundle picker.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundles",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Build your bundle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One box. Every room." },
    {
      "type": "text",
      "id": "lede",
      "label": "Supporting line",
      "default": "Mix and match across kitchen, laundry, home and skin."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Most popular" },
        { "type": "number", "id": "quantity", "label": "Product quantity", "default": 3 },
        { "type": "number", "id": "price", "label": "Price", "default": 499 },
        { "type": "number", "id": "compare_at_price", "label": "Compare-at price", "default": 897 },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "info": "One per line.",
          "default": "Pick any three products\nFree shipping across India"
        },
        { "type": "checkbox", "id": "highlight", "label": "Highlight as best value", "default": false },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Build this box" },
        { "type": "url", "id": "cta_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundles",
      "blocks": [
        {
          "type": "tier",
          "settings": { "tag": "Starter", "quantity": 2, "price": 349, "compare_at_price": 598, "cta_link": "#shop" }
        },
        {
          "type": "tier",
          "settings": {
            "tag": "Most popular",
            "quantity": 3,
            "price": 499,
            "compare_at_price": 897,
            "highlight": true,
            "cta_link": "#shop"
          }
        },
        {
          "type": "tier",
          "settings": { "tag": "Whole home", "quantity": 5, "price": 799, "compare_at_price": 1495, "cta_link": "#shop" }
        }
      ]
    }
  ]
}
{% endschema %}
