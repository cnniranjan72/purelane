{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-how-it-works.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign pillar_blocks = section.blocks | where: 'type', 'pillar' -%}

<section
  id="how-it-works"
  class="how-it-works color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    %}

    {%- if pillar_blocks.size > 0 -%}
      <div class="pillars">
        {%- for block in pillar_blocks -%}
          <article
            class="pillar pl-surface pl-tilt{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="pillar__icon">
              {% render 'icon', name: block.settings.icon, size: 24 %}
            </span>
            {%- if block.settings.heading != blank -%}
              <h3 class="pillar__heading">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="pillar__body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
            {%- if block.settings.link_label != blank -%}
              <a
                {% if block.settings.link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.link }}"
                {% endif %}
                class="button button--secondary pillar__link"
              >
                {{- block.settings.link_label | escape -}}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="how-it-works__empty">Add a pillar block to feature it here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The short version" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "text", "id": "lede", "label": "Supporting line" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" },
            { "value": "no-chemicals", "label": "No chemicals" },
            { "value": "sprout", "label": "Sprout" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Less scrubbing" },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "droplet",
            "heading": "Less scrubbing",
            "body": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield",
            "heading": "Clean ingredients",
            "body": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "leaf",
            "heading": "Safe around everyone",
            "body": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day."
          }
        }
      ]
    }
  ]
}
{% endschema %}
