{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-why-it-works.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
{%- assign product_blocks = section.blocks | where: 'type', 'product' -%}

<section
  id="why-it-works"
  class="why-it-works color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    <div class="why-it-works__panel pl-surface{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="why-it-works__grid">
        <div class="why-it-works__intro">
          {%- if section.settings.kicker != blank -%}
            <p class="section-heading__kicker">{{ section.settings.kicker | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="why-it-works__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <p class="why-it-works__body">{{ section.settings.body | escape }}</p>
          {%- endif -%}
          {%- if section.settings.link_label != blank -%}
            <a
              {% if section.settings.link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.link }}"
              {% endif %}
              class="button button--primary why-it-works__link"
            >
              {{- section.settings.link_label | escape -}}
              {% render 'icon', name: 'arrow', size: 16 %}
            </a>
          {%- endif -%}
        </div>

        {%- if product_blocks.size > 0 -%}
          <hero-stage class="why-it-works__rotator">
            {%- for block in product_blocks -%}
              {%- assign product = block.settings.product -%}
              <div
                class="why-it-works__slide{% if forloop.first %} is-active{% endif %}"
                data-hero-slide
                {% unless forloop.first %}aria-hidden="true"{% endunless %}
                {{ block.shopify_attributes }}
              >
                {%- if product != blank -%}
                  <span class="why-it-works__slide-icon">
                    {% render 'product-icon', color: block.settings.icon_color, name: product.title %}
                  </span>
                  <p class="why-it-works__slide-name">{{ product.title }}</p>
                  {%- if block.settings.tagline != blank -%}
                    <p class="why-it-works__slide-tagline">{{ block.settings.tagline | escape }}</p>
                  {%- endif -%}
                {%- endif -%}
              </div>
            {%- endfor -%}

            {%- if product_blocks.size > 1 -%}
              <div class="hero__dots" role="group" aria-label="Featured product">
                {%- for block in product_blocks -%}
                  <button
                    type="button"
                    aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                    aria-label="Show product {{ forloop.index }} of {{ forloop.length }}"
                    data-hero-dot
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </hero-stage>
        {%- endif -%}
      </div>

      {%- if stat_blocks.size > 0 -%}
        <div class="why-it-works__stats">
          {%- for block in stat_blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="stat__ring">{{ block.settings.value | escape }}</div>
              {%- if block.settings.label != blank -%}
                <h3 class="stat__label">{{ block.settings.label | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="stat__desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if product_blocks.size > 1 -%}
  <script src="{{ 'hero-stage.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Why it works",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Why it works" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime. Gentle on everything else."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See the ingredient list" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "99.9%" },
        { "type": "text", "id": "label", "label": "Label", "default": "Germ kill" },
        { "type": "text", "id": "description", "label": "Description", "default": "Tested against germs and bacteria" }
      ]
    },
    {
      "type": "product",
      "name": "Featured product",
      "limit": 3,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "Foam lifts grease, no scrubbing" },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Product icon color",
          "default": "#6b55b8"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why it works",
      "blocks": [
        {
          "type": "stat",
          "settings": { "value": "99.9%", "label": "Germ kill", "description": "Tested against germs and bacteria" }
        },
        {
          "type": "stat",
          "settings": { "value": "0%", "label": "Sulphates", "description": "No SLS, chlorine or parabens" }
        },
        {
          "type": "stat",
          "settings": { "value": "100%", "label": "Plant based", "description": "Cleansers derived from plants" }
        },
        {
          "type": "stat",
          "settings": { "value": "4.8", "label": "Rated", "description": "Across 8,000+ verified reviews" }
        }
      ]
    }
  ]
}
{% endschema %}
