{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-bundle-categories.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign category_blocks = section.blocks | where: 'type', 'category' -%}

<section
  id="bundle-categories"
  class="bundle-categories color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    %}

    {%- if category_blocks.size > 0 -%}
      <div class="categories">
        {%- for block in category_blocks -%}
          <a
            {% if block.settings.link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ block.settings.link }}"
            {% endif %}
            class="category pl-surface pl-tilt{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <span class="category__ph">
              {%- if block.settings.product != blank -%}
                {% render 'product-icon', color: block.settings.icon_color, name: block.settings.product.title %}
              {%- else -%}
                {% render 'icon', name: 'droplet', size: 40 %}
              {%- endif -%}
            </span>
            <span class="category__text">
              {%- if block.settings.heading != blank -%}
                <span class="category__heading">{{ block.settings.heading | escape }}</span>
              {%- endif -%}
              {%- if block.settings.body != blank -%}
                <span class="category__body">{{ block.settings.body | escape }}</span>
              {%- endif -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="bundle-categories__empty">Add a category block to feature it here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Bundle categories",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bundle categories" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find the right bundle for you" },
    { "type": "text", "id": "lede", "label": "Supporting line" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Representative product"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Product icon color",
          "default": "#6b55b8"
        },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Kitchen bundle" },
        { "type": "text", "id": "body", "label": "Description", "default": "Grease, dishes & more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle categories",
      "blocks": [
        { "type": "category", "settings": { "heading": "Kitchen bundle", "body": "Grease, dishes & more" } },
        { "type": "category", "settings": { "heading": "Bathroom bundle", "body": "Deep clean & disinfect" } },
        { "type": "category", "settings": { "heading": "Laundry bundle", "body": "Softer, fresher wash" } },
        { "type": "category", "settings": { "heading": "Hard water bundle", "body": "Melt away limescale" } }
      ]
    }
  ]
}
{% endschema %}
