{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-shop.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign has_products = false
  if collection != blank and collection.products.size > 0
    assign has_products = true
  endif
-%}

<section
  id="shop"
  class="shop color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    %}

    <ul class="shop-grid grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down" role="list">
      {%- if has_products -%}
        {%- for product in collection.products limit: products_to_show -%}
          <li
            class="shop-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- if product.tags contains 'best-seller' and section.settings.badge_best_seller_label != blank -%}
              <span class="shop-grid__tag-badge">{{ section.settings.badge_best_seller_label | escape }}</span>
            {%- elsif product.tags contains 'new' and section.settings.badge_new_label != blank -%}
              <span class="shop-grid__tag-badge">{{ section.settings.badge_new_label | escape }}</span>
            {%- elsif product.tags contains 'top-rated' and section.settings.badge_top_rated_label != blank -%}
              <span class="shop-grid__tag-badge">{{ section.settings.badge_top_rated_label | escape }}</span>
            {%- endif -%}
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: 'square',
              show_rating: true,
              lazy_load: forloop.index > section.settings.columns_desktop,
              section_id: section.id,
              quick_add: section.settings.quick_add
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Empty collection / not yet configured: same placeholder cards Dawn uses elsewhere, so the merchant sees the real card design instead of a blank grid. {%- endcomment -%}
        {%- for i in (1..section.settings.columns_desktop) -%}
          <li
            class="shop-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {% render 'card-product', media_aspect_ratio: 'square' %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if has_products and section.settings.show_view_all -%}
      <div class="shop-grid__view-all">
        <a href="{{ collection.url }}" class="button button--secondary">View all</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by 30,000 homes" },
    { "type": "text", "id": "lede", "label": "Supporting line" },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products, prices, images, sold-out state and reviews all come straight from this collection — nothing here is hardcoded."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "quick_add",
      "label": "Quick add button",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "standard", "label": "Standard" }
      ],
      "default": "standard"
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"View all\" link", "default": true },
    { "type": "header", "content": "Product badges" },
    {
      "type": "paragraph",
      "content": "Shown on products tagged best-seller, new, or top-rated. Leave a label blank to hide that badge."
    },
    { "type": "text", "id": "badge_best_seller_label", "label": "\"best-seller\" tag label", "default": "Best seller" },
    { "type": "text", "id": "badge_new_label", "label": "\"new\" tag label", "default": "New" },
    { "type": "text", "id": "badge_top_rated_label", "label": "\"top-rated\" tag label", "default": "Top rated" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Shop grid"
    }
  ]
}
{% endschema %}
