{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-trust-bar.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign item_blocks = section.blocks | where: 'type', 'item' -%}

<section
  id="trust-bar"
  class="trust-bar color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    <h2 class="visually-hidden">Why Purelane</h2>
    {%- if item_blocks.size > 0 -%}
      <ul class="trust-items pl-surface" role="list">
        {%- for block in item_blocks -%}
          <li class="trust-item" {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon, size: 22 %}
            <span>{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- else -%}
      <p class="trust-bar__empty">Add an item block to feature it here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "package", "label": "Package" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "label", "label": "Label", "default": "Plant derived formulas" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item", "settings": { "icon": "leaf", "label": "Plant derived formulas" } },
        { "type": "item", "settings": { "icon": "package", "label": "Recyclable packaging" } },
        { "type": "item", "settings": { "icon": "heart", "label": "Safe for kids & pets" } },
        { "type": "item", "settings": { "icon": "globe", "label": "Made in India" } }
      ]
    }
  ]
}
{% endschema %}
