{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-ingredients.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign ingredient_blocks = section.blocks | where: 'type', 'ingredient' -%}

<section
  id="ingredients"
  class="ingredients color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- if ingredient_blocks.size > 0 -%}
      <div class="ingredients-panel pl-surface{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {% render 'section-heading',
          kicker: section.settings.kicker,
          heading: section.settings.heading,
          lede: section.settings.lede
        %}

        <div class="ingredients-grid">
          {%- for block in ingredient_blocks -%}
            <div class="ingredients-grid__item" {{ block.shopify_attributes }}>
              <span class="ingredients-grid__icon">
                {% render 'icon', name: block.settings.icon, size: 32 %}
              </span>
              {%- if block.settings.name != blank -%}
                <h3 class="ingredients-grid__name">{{ block.settings.name | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.description != blank -%}
                <p class="ingredients-grid__desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <p class="ingredients__empty">Add an ingredient block to feature it here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "What's inside" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Sourced from nature" },
    { "type": "text", "id": "lede", "label": "Supporting line" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "droplet", "label": "Droplet" },
            { "value": "citrus", "label": "Citrus" },
            { "value": "sprout", "label": "Sprout" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "shield", "label": "Shield" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Coconut" },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        {
          "type": "ingredient",
          "settings": { "icon": "droplet", "name": "Coconut", "description": "Plant-derived cleansers that lift grease" }
        },
        {
          "type": "ingredient",
          "settings": { "icon": "citrus", "name": "Orange peel", "description": "Natural degreaser and fresh citrus lift" }
        },
        {
          "type": "ingredient",
          "settings": { "icon": "sprout", "name": "Soap nut", "description": "A traditional plant foaming agent" }
        },
        {
          "type": "ingredient",
          "settings": { "icon": "leaf", "name": "Neem", "description": "Time-tested antibacterial from the tree" }
        },
        {
          "type": "ingredient",
          "settings": { "icon": "sprout", "name": "Lemongrass", "description": "Clean fragrance with nothing synthetic" }
        }
      ]
    }
  ]
}
{% endschema %}
