{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-combos.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign combo_blocks = section.blocks | where: 'type', 'combo'
  assign has_combo_content = false
  for block in combo_blocks
    if block.settings.combo_ref != blank
      assign has_combo_content = true
    endif
  endfor
  assign icon_palette = '6b55b8,5a46a3,6250ad,55429b,8168c9,8f74d4' | split: ','
-%}

<section
  id="combos"
  class="combos color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {% render 'section-heading',
      kicker: section.settings.kicker,
      heading: section.settings.heading,
      lede: section.settings.lede
    %}

    {%- if has_combo_content -%}
      <slider-component>
        <ul
          id="Slider-combos-{{ section.id }}"
          class="combos-rail slider slider--mobile slider--tablet page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          role="list"
        >
          {%- for block in combo_blocks -%}
            {%- assign combo = block.settings.combo_ref -%}
            <li
              id="Slide-combos-{{ section.id }}-{{ forloop.index }}"
              class="combos-rail__slide slider__slide"
              {{ block.shopify_attributes }}
            >
              {%- if combo != blank -%}
                <article class="combo-card pl-surface pl-tilt">
                  {%- if combo.components.value.size > 0 -%}
                    <div class="combo-card__tray">
                      {%- liquid
                        assign bundle = combo.bundle_product.value
                        assign saving = 0
                        if bundle != blank and bundle.compare_at_price > bundle.price
                          assign saving = bundle.compare_at_price | minus: bundle.price
                        endif
                      -%}
                      {%- if saving > 0 -%}
                        <span class="combo-card__save">You save {{ saving | money_without_trailing_zeros }}</span>
                      {%- endif -%}
                      {%- if combo.flag != blank -%}
                        <span class="combo-card__flag">{{ combo.flag.value | escape }}</span>
                      {%- endif -%}
                      <div class="combo-card__stack" aria-hidden="true">
                        {%- for component in combo.components.value limit: 3 -%}
                          {%- unless forloop.first -%}
                            <span class="combo-card__plus">+</span>
                          {%- endunless -%}
                          {%- assign icon_index = forloop.index0 | modulo: icon_palette.size -%}
                          <span class="combo-card__thumb">
                            {% render 'product-icon', color: icon_palette[icon_index], name: component.title %}
                          </span>
                        {%- endfor -%}
                      </div>
                    </div>
                  {%- elsif combo.flag != blank -%}
                    <span class="combo-card__flag">{{ combo.flag.value | escape }}</span>
                  {%- endif -%}

                  <div class="combo-card__body">
                    <h3 class="combo-card__name">{{ combo.name.value | escape }}</h3>
                    {%- if combo.components.value.size > 0 -%}
                      <p class="combo-card__count">{{ combo.components.value.size }} products</p>
                    {%- endif -%}
                    {%- if combo.description.value != blank -%}
                      <p class="combo-card__desc">{{ combo.description.value }}</p>
                    {%- endif -%}

                    {%- if combo.bundle_product.value != blank -%}
                      {% render 'price-tag', product: combo.bundle_product.value, show_savings_amount: true %}
                      {%- if section.settings.price_note != blank -%}
                        <p class="combo-card__note">{{ section.settings.price_note | escape }}</p>
                      {%- endif -%}
                      <a
                        href="{{ combo.bundle_product.value.url }}"
                        class="button button--secondary combo-card__cta"
                      >
                        {{- section.settings.cta_label | escape -}}
                        {% render 'icon', name: 'arrow', size: 16 %}
                      </a>
                    {%- endif -%}
                  </div>
                </article>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>

        <div class="slider-buttons">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="Previous combo" aria-controls="Slider-combos-{{ section.id }}">
            {% render 'icon', name: 'arrow', size: 18 %}
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="slider-counter--total">{{ combo_blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="Next combo" aria-controls="Slider-combos-{{ section.id }}">
            {% render 'icon', name: 'arrow', size: 18 %}
          </button>
        </div>
      </slider-component>

      {%- if section.settings.swipe_hint != blank -%}
        <p class="combos__hint">
          {% render 'icon', name: 'arrow', size: 14 %}
          {{ section.settings.swipe_hint | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.rail_note != blank -%}
        <p class="combos__note">{{ section.settings.rail_note | escape }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="combos__empty">Add a combo block and pick a "combo" entry to feature it here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best-selling combos",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    {
      "type": "text",
      "id": "lede",
      "label": "Supporting line",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    { "type": "text", "id": "cta_label", "label": "Card button label", "default": "Shop bundle" },
    {
      "type": "text",
      "id": "price_note",
      "label": "Price note",
      "default": "Inclusive of all taxes · COD available"
    },
    { "type": "text", "id": "swipe_hint", "label": "Swipe hint", "default": "Swipe for more combos" },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "Rail note",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "metaobject",
          "id": "combo_ref",
          "metaobject_type": "combo",
          "label": "Combo",
          "info": "Price, savings and product images come from the combo's bundle product — see Metaobjects.md."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Best-selling combos",
      "blocks": [{ "type": "combo" }, { "type": "combo" }, { "type": "combo" }]
    }
  ]
}
{% endschema %}
