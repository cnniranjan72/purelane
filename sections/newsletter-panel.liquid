{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-newsletter-panel.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="newsletter-panel"
  class="newsletter-panel color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    <div class="newsletter-panel__inner pl-surface">
      {%- if section.settings.kicker != blank -%}
        <p class="section-heading__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter-panel__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.lede != blank -%}
        <p class="section-heading__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}

      {%- form 'customer', id: 'ContactNewsletterPanel', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-panel__row">
          <label class="visually-hidden" for="NewsletterPanel--{{ section.id }}">
            {{ 'newsletter.label' | t }}
          </label>
          <input
            id="NewsletterPanel--{{ section.id }}"
            type="email"
            name="contact[email]"
            class="newsletter-panel__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            {% if form.errors %}
              autofocus
              aria-invalid="true"
              aria-describedby="ContactNewsletterPanel-error"
            {% elsif form.posted_successfully? %}
              aria-describedby="ContactNewsletterPanel-success"
            {% endif %}
            placeholder="your@email.com"
            required
          >
          <button type="submit" class="button button--primary newsletter-panel__submit" name="commit">
            {{ section.settings.button_label | escape }}
          </button>
        </div>
        {%- if form.errors -%}
          <small class="newsletter-form__message form__message" id="ContactNewsletterPanel-error">
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </small>
        {%- endif -%}
        {%- if form.posted_successfully? -%}
          <h3
            class="newsletter-form__message newsletter-form__message--success form__message"
            id="ContactNewsletterPanel-success"
            tabindex="-1"
            autofocus
          >
            {{- 'newsletter.success' | t }}
          </h3>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter panel",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Join the Purelane Club" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get ₹100 off your first bundle" },
    {
      "type": "text",
      "id": "lede",
      "label": "Supporting line",
      "default": "Plus first access to new launches and restocks."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get my ₹100 off" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Newsletter panel"
    }
  ]
}
{% endschema %}
