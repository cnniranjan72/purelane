{{ 'purelane-shared.css' | asset_url | stylesheet_tag }}
{{ 'section-product-shelf.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show
  assign has_products = false
  if collection != blank and collection.products.size > 0
    assign has_products = true
  endif
  assign icon_palette = '6b55b8,5a46a3,6250ad,55429b,8168c9,8f74d4' | split: ','
-%}

<section
  id="product-shelf"
  class="product-shelf color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    <div class="product-shelf__panel pl-surface{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="product-shelf__head">
      <div>
        {%- if section.settings.kicker != blank -%}
          <p class="section-heading__kicker">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title product-shelf__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.lede != blank -%}
        <p class="product-shelf__lede">{{ section.settings.lede | escape }}</p>
      {%- endif -%}
    </div>

    {%- if has_products -%}
      {%- comment -%}
        A plain horizontally-scrollable strip, matching the reference's
        `.stripwrap` - keyboard-reachable via each product link and native
        scroll, so it needs no slider chrome or counter.
      {%- endcomment -%}
      <ul
        class="product-shelf-rail{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        role="list"
        tabindex="0"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {%- for product in collection.products limit: products_to_show -%}
          <li class="product-shelf-rail__slide">
            {%- assign icon_index = forloop.index0 | modulo: icon_palette.size -%}
            <a href="{{ product.url }}" class="product-shelf-card" title="{{ product.title | escape }}">
              <span class="visually-hidden">{{ product.title }}</span>
              <span class="product-shelf-card__thumb">
                {% render 'product-icon', color: icon_palette[icon_index], name: product.title %}
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>

      {%- if section.settings.hint != blank -%}
        <p class="product-shelf__hint">{{ section.settings.hint | escape }}</p>
      {%- endif -%}
    {%- else -%}
      <p class="product-shelf__empty">Pick a collection to feature its products here.</p>
    {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product shelf",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The full range" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every room, one shelf" },
    {
      "type": "text",
      "id": "lede",
      "label": "Supporting line",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands — plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Every product shown here, and its image, comes straight from this collection."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 11,
      "label": "Products to show"
    },
    { "type": "text", "id": "hint", "label": "Swipe hint", "default": "Swipe to see the full shelf" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    { "type": "header", "content": "Padding" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Product shelf"
    }
  ]
}
{% endschema %}
