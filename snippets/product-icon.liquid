{% comment %}
  Renders a decorative spray-bottle silhouette icon, the same
  cap+neck+gradient-body+label-bars construction the reference file uses
  for every product mention (just recolored per product there). Used
  wherever a product needs a small, consistent icon rather than real
  photography — the actual product grid still renders real Shopify images
  via card-product.liquid; this is for hero/product-shelf/categories/combo
  thumbnails where the reference itself uses decorative icons too.

  Accepts:
  - color: {String} hex color, e.g. "6b55b8" (with or without #)
  - name: {String} accessible label
  - variant: {String} 'tall' for the slim hero bottle (aspect ~0.32);
    omit for the default squat bottle used on cards (~0.63)

  Usage:
  {% render 'product-icon', color: '6b55b8', name: product.title %}
{% endcomment %}
{%- liquid
  assign fill = color | default: '#6b55b8' | remove: '#'
  assign uid = fill | append: name | append: variant | md5 | slice: 0, 8
-%}
{%- if variant == 'tall' -%}
  {%- comment -%}
    Tall spray-bottle proportions (aspect ~0.32), matching the reference's
    hero bottles. The squat default below (~0.63) is what it uses on shop
    cards and the shelf strip - using the squat shape in the hero is what
    made the three-bottle group collide instead of layering.
  {%- endcomment -%}
  <svg
    class="product-icon product-icon--tall"
    viewBox="0 0 380 1177"
    role="img"
    aria-label="{{ name | escape }}"
    preserveAspectRatio="xMidYMax meet"
  >
    <defs>
      <linearGradient id="picg-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#{{ fill }}" stop-opacity=".95" />
        <stop offset="1" stop-color="#{{ fill }}" stop-opacity=".62" />
      </linearGradient>
    </defs>
    <rect x="149.9" y="0" width="80.1" height="117.7" rx="17.6" fill="#{{ fill }}" opacity=".85" />
    <rect x="161.2" y="105.9" width="57.7" height="82.4" fill="#{{ fill }}" opacity=".7" />
    <rect x="72.2" y="235.4" width="235.6" height="941.6" rx="37.7" fill="url(#picg-{{ uid }})" />
    <rect x="100.5" y="517.9" width="179.1" height="320.1" rx="11.8" fill="#faf7fd" opacity=".88" />
    <rect x="128.7" y="612" width="122.5" height="42.4" rx="2" fill="#{{ fill }}" opacity=".55" />
    <rect x="142.9" y="696.8" width="94.2" height="33" rx="2" fill="#{{ fill }}" opacity=".35" />
  </svg>
{%- else -%}
  <svg
    class="product-icon"
    viewBox="0 0 190 300"
    role="img"
    aria-label="{{ name | escape }}"
    preserveAspectRatio="xMidYMax meet"
  >
    <defs>
      <linearGradient id="picg-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#{{ fill }}" stop-opacity=".95" />
        <stop offset="1" stop-color="#{{ fill }}" stop-opacity=".62" />
      </linearGradient>
    </defs>
    <rect x="75" y="0" width="40" height="30" rx="9" fill="#{{ fill }}" opacity=".85" />
    <rect x="81" y="27" width="29" height="21" fill="#{{ fill }}" opacity=".7" />
    <rect x="36" y="60" width="118" height="240" rx="19" fill="url(#picg-{{ uid }})" />
    <rect x="50" y="132" width="90" height="82" rx="6" fill="#faf7fd" opacity=".88" />
    <rect x="64" y="156" width="61" height="11" rx="2" fill="#{{ fill }}" opacity=".55" />
    <rect x="71" y="178" width="47" height="8" rx="2" fill="#{{ fill }}" opacity=".35" />
  </svg>
{%- endif -%}
